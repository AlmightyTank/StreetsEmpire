# Street Empire - local configuration
#
# Copy this to `.env` in this same folder and fill in what you need. `.env` is gitignored; this file
# is not, so never put a real secret in here.
#
#   cp .env.example .env
#
# The names are the appsettings.json paths with `__` (two underscores) where the JSON nests. That is
# .NET's own convention, and it means anything in appsettings.json can be overridden here, not just
# the secrets. A value already set in the real environment always wins over this file, so a hosting
# platform that injects secrets keeps working with a .env sitting next to it.
#
# The game runs with none of this filled in. Discord sign-in is simply not offered, and verification
# codes are written to the server log instead of being emailed.


# ---------------------------------------------------------------------------- Database
# Only needed if you are not using the docker-compose Postgres on its default port.
# ConnectionStrings__GameDatabase=Host=localhost;Port=5432;Database=street_empire;Username=street_empire;Password=street_empire_dev


# ----------------------------------------------------------------------- Discord login
# Make an application at https://discord.com/developers/applications, then under OAuth2 add the
# redirect below exactly as it is written - Discord compares the string, not the destination.
#
# Both an id and a secret are needed. With only one of them the button stays hidden, on purpose: a
# half-configured provider would send a player to Discord and fail them on the way back.
Auth__Discord__ClientId=
Auth__Discord__ClientSecret=

# Where Discord sends the browser back to. Must match the Discord application character for character.
# Points at the API rather than the client because the client's dev port moves and a moving port
# cannot be registered anywhere; cookies ignore the port, so the session still lands.
# Auth__Discord__RedirectUri=http://localhost:5080/api/auth/discord/callback

# Where the player is put down afterwards when the client did not name somewhere itself.
# Auth__Discord__ReturnUrl=http://localhost:5173/


# --------------------------------------------------------------------------- Sending mail
# A Resend API key, from https://resend.com/api-keys. Without one, verification codes are written to
# the server log instead of being sent - which is enough to click the whole flow through locally.
Auth__Email__ApiKey=

# Must be a domain verified with Resend. Their sandbox sender, onboarding@resend.dev, is the shipped
# default and will only ever deliver to the Resend account's own owner - fine for a first test,
# useless for players.
# Auth__Email__FromAddress=Street Empire <no-reply@yourdomain.example>

# The three numbers that make a six-digit code safe. Shorten them if you like; lengthening the
# lifetime much past this is how a million-possibility code becomes guessable.
# Auth__Email__CodeLifetimeMinutes=15
# Auth__Email__MaxAttempts=5
# Auth__Email__ResendCooldownSeconds=60
# The most codes one address is sent in a day, however they were asked for.
# Auth__Email__MaxCodesPerDay=10

# Whether signing up (and changing your address) puts a code in the post straight away.
# Auth__Email__SendOnSignUp=true

# Whether a change to a way in - password, address, Discord, sessions - is reported to the confirmed
# address on the account. Leave this on: it is what lets somebody notice their account being taken.
# Auth__Email__SendSecurityNotices=true

# How long a spent or expired code is kept before the daily sweep takes it.
# Auth__Email__CodeRetentionDays=7


# -------------------------------------------------------------------------------- CORS
# An array is written with its index. Only matters once the client is served from its own origin
# rather than through the Vite proxy, which makes its calls same-origin.
# Cors__AllowedOrigins__0=http://localhost:5173
# Cors__AllowedOrigins__1=http://localhost:3000
